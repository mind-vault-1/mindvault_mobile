        "X-Signature": "<HMAC_SHA256_HEX>"
      },
      "body": {
        "newCreator": "GNEWCREATORABCDEFGHIJKLMNOPQRSTUVWXYZ234567ABCDEFGHIJKLMNOPQRSTUV"
      },
      "required": [
        "newCreator"
      ]
    },
    "response": {
      "status": 200,
      "body": {
        "unsignedXdr": "AAAAAgAAAAB...",
        "networkPassphrase": "Test SDF Network ; September 2015"
      },
      "required": [
        "unsignedXdr"
      ]
    }
  },
