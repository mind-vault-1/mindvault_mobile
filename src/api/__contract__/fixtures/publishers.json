  "delist": {
    "method": "DELETE",
    "path": "/resources/{id}",
    "request": {
      "headers": {
        "Content-Type": "application/json",
        "x-api-key": "<PUBLISHER_API_KEY>",
        "X-Timestamp": "<UNIX_SECONDS>",
        "X-Signature": "<HMAC_SHA256_HEX>"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "id": "res_123",
        "message": "Resource delisted"
      },
      "required": [
        "id"
      ]
    }
  },
  "rotateApiKey": {
    "method": "POST",
    "path": "/publishers/me/api-key/rotate",
    "request": {
      "headers": {
        "x-api-key": "<PUBLISHER_API_KEY>",
        "X-Timestamp": "<UNIX_SECONDS>",
        "X-Signature": "<HMAC_SHA256_HEX>"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "apiKey": "<NEW_API_KEY>"
      },
      "required": [
        "apiKey"
      ]
    }
  }
}
