{
  "components": {
    "schemas": {
      "AgentStatusResponse": {
        "properties": {
          "agent": {
            "properties": {
              "currency": {
                "type": "string"
              },
              "endpoint": {
                "format": "uri",
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "network": {
                "type": "string"
              },
              "pricePerVerification": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "walletAddress": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "recentActivity": {
            "items": {
              "properties": {
                "checkedAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "confidence": {
                  "type": "number"
                },
                "flags": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "id": {
                  "type": "string"
                },
                "isOriginal": {
                  "type": "boolean"
                },
                "resourceTitle": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "stats": {
            "properties": {
              "avgConfidence": {
                "type": "string"
              },
              "rejected": {
                "type": "integer"
              },
              "totalEarned": {
                "type": "string"
              },
              "totalVerifications": {
                "type": "integer"
              },
              "verified": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "usage": {
            "description": "Aggregate model token usage and estimated spend across all verifications",
            "properties": {
              "estimatedCostUsd": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "totalCompletionTokens": {
                "type": "integer"
              },
              "totalPromptTokens": {
                "type": "integer"
              },
              "totalTokens": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "example": "Resource not found",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "example": "mindvault",
            "type": "string"
          },
          "status": {
            "example": "ok",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Publisher": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "walletAddress": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "PublisherRegisterRequest": {
        "properties": {
          "email": {
            "example": "alice@example.com",
            "format": "email",
            "type": "string"
          },
          "name": {
            "example": "Alice",
            "type": "string"
          },
          "walletAddress": {
            "description": "Stellar wallet address",
            "example": "GABC...XYZ",
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "walletAddress"
        ],
        "type": "object"
      },
      "PublisherRegisterResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Publisher"
          },
          {
            "properties": {
              "apiKey": {
                "description": "Shown once — store it securely",
                "type": "string"
              }
            },
            "type": "object"
          }
        ]
      },
      "RateLimitError": {
        "properties": {
          "code": {
            "example": "RATE_LIMITED",
            "type": "string"
          },
          "error": {
            "example": "Too many requests",
            "type": "string"
          },
          "retryAfterSeconds": {
            "example": 60,
            "type": "integer"
          }
        },
        "required": [
          "error",
          "code",
          "retryAfterSeconds"
        ],
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "properties": {
              "database": {
                "enum": [
                  "ok",
                  "error"
                ],
                "type": "string"
              },
              "sorobanRpc": {
                "enum": [
                  "ok",
                  "error"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "service": {
            "example": "mindvault",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RegistryStatusResponse": {
        "properties": {
          "contractId": {
            "type": "string"
          },
          "network": {
            "example": "testnet",
            "type": "string"
          },
          "resourceCount": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Resource": {
        "properties": {
          "accessUrl": {
            "format": "uri",
            "type": "string"
          },
          "contentHash": {
            "description": "SHA-256 content integrity anchor recorded in the on-chain registry metadata; null when no anchor is available.",
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "listed": {
            "type": "boolean"
          },
          "onchainStatus": {
            "enum": [
              "none",
              "pending",
              "registered",
              "failed"
            ],
            "type": "string"
          },
          "onchainTxHash": {
            "nullable": true,
            "type": "string"
          },
          "price": {
            "example": "0.50",
            "type": "string"
          },
          "resourceType": {
            "enum": [
              "file",
              "link"
            ],
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "verificationStatus": {
            "enum": [
              "pending",
              "verified",
              "rejected"
            ],
            "type": "string"
          },
          "walletAddress": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "UnsignedTxResponse": {
        "properties": {
          "networkPassphrase": {
            "type": "string"
          },
          "unsignedXdr": {
            "description": "Base64-encoded unsigned Stellar transaction",
            "type": "string"
          }
        },
        "type": "object"
      },
      "VerificationResult": {
        "properties": {
          "confidence": {
            "format": "float",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "isOriginal": {
            "type": "boolean"
          },
          "usage": {
            "description": "Model token usage and estimated cost for this verification",
            "properties": {
              "completionTokens": {
                "type": "integer"
              },
              "estimatedCostUsd": {
                "format": "float",
                "type": "number"
              },
              "promptTokens": {
                "type": "integer"
              },
              "totalTokens": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "Publisher API key returned on registration",
        "in": "header",
        "name": "x-api-key",
        "type": "apiKey"
      },
      "RequestSignature": {
        "description": "Optional HMAC-SHA256 hex digest over method, path, timestamp, and body (required when REQUIRE_REQUEST_SIGNATURE is enabled). Pair with X-Timestamp (unix seconds). The API key is the HMAC secret. See docs/request-signature.md.",
        "in": "header",
        "name": "X-Signature",
        "type": "apiKey"
      },
      "X402Payment": {
        "description": "Base64-encoded x402 payment payload",
        "in": "header",
        "name": "X-Payment",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "A marketplace where humans and AI agents publish and trade digital resources via HTTP 402 payments on Stellar.\n\n**Optional request signatures:** When the server has `REQUIRE_REQUEST_SIGNATURE=true`, publisher mutations (POST/DELETE on `/resources/*`) must include `X-Timestamp` and `X-Signature` headers. See `docs/request-signature.md`.",
    "license": {
      "name": "MIT"
    },
    "title": "MindVault API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/agent/status": {
      "get": {
        "operationId": "getAgentStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentStatusResponse"
                }
              }
            },
            "description": "Agent status"
          }
        },
        "summary": "Public agent stats and recent verification activity",
        "tags": [
          "Verify"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service is alive"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Checks database and Soroban RPC connectivity.",
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "All dependencies healthy"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "One or more dependencies unavailable"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "Health"
        ]
      }
    },
    "/publishers": {
      "post": {
        "operationId": "registerPublisher",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublisherRegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublisherRegisterResponse"
                }
              }
            },
            "description": "Publisher created — API key shown once"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Email already registered"
          }
        },
        "summary": "Register a new publisher",
        "tags": [
          "Publishers"
        ]
      }
    },
    "/publishers/leaderboard": {
      "get": {
        "operationId": "getLeaderboard",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "joinedAt": {
                        "format": "date-time",
                        "type": "string"
                      },
                      "listedResources": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      },
                      "totalEarned": {
                        "type": "string"
                      },
                      "totalResources": {
                        "type": "integer"
                      },
                      "totalSales": {
                        "type": "integer"
                      },
                      "verifiedResources": {
                        "type": "integer"
                      },
                      "walletAddress": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Leaderboard array"
          }
        },
        "summary": "Public creator leaderboard sorted by earnings",
        "tags": [
          "Publishers"
        ]
      }
    },
    "/publishers/me": {
      "get": {
        "operationId": "getMyProfile",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Publisher"
                }
              }
            },
            "description": "Own profile"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid API key"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Get own publisher profile",
        "tags": [
          "Publishers"
        ]
      }
    },
    "/publishers/me/analytics": {
      "get": {
        "operationId": "getMyAnalytics",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "resources": {
                      "items": {
                        "$ref": "#/components/schemas/Resource"
                      },
                      "type": "array"
                    },
                    "summary": {
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "listedResources": {
                          "type": "integer"
                        },
                        "totalEarned": {
                          "type": "string"
                        },
                        "totalResources": {
                          "type": "integer"
                        },
                        "totalSales": {
                          "type": "integer"
                        },
                        "verification": {
                          "properties": {
                            "pending": {
                              "type": "integer"
                            },
                            "rejected": {
                              "type": "integer"
                            },
                            "verified": {
                              "type": "integer"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Analytics summary"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Earnings and stats for own resources",
        "tags": [
          "Publishers"
        ]
      }
    },
    "/publishers/me/resources": {
      "get": {
        "operationId": "getMyResources",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Resource"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Array of resources"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "List own resources",
        "tags": [
          "Publishers"
        ]
      }
    },
    "/publishers/wallet/{address}": {
      "get": {
        "operationId": "getPublisherByWallet",
        "parameters": [
          {
            "description": "Stellar wallet address",
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Publisher"
                }
              }
            },
            "description": "Publisher found"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "summary": "Look up publisher by wallet address",
        "tags": [
          "Publishers"
        ]
      }
    },
    "/registry/status": {
      "get": {
        "operationId": "getRegistryStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistryStatusResponse"
                }
              }
            },
            "description": "Registry status"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Registry unavailable"
          }
        },
        "summary": "On-chain registry metadata and resource count",
        "tags": [
          "Registry"
        ]
      }
    },
    "/resources": {
      "get": {
        "operationId": "listResources",
        "parameters": [
          {
            "description": "Filter resources by title or description (case-insensitive)",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sort order. Defaults to newest first.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "enum": [
                "newest",
                "price_asc",
                "price_desc",
                "title"
              ],
              "type": "string"
            }
          },
          {
            "description": "Max number of resources to return (1-100, default 20).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Number of resources to skip for pagination.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Resource"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Array of listed resources. Pagination metadata is returned via the X-Total-Count, X-Limit, X-Offset, and X-Next-Offset response headers (X-Next-Offset is omitted on the last page).",
            "headers": {
              "X-Limit": {
                "description": "The page size used for this response.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Next-Offset": {
                "description": "Offset to use for the next page. Omitted on the last page.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Offset": {
                "description": "The offset used for this response.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count": {
                "description": "Total number of matching resources across all pages.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Browse public resource catalog",
        "tags": [
          "Resources"
        ]
      },
      "post": {
        "operationId": "publishResource",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "externalUrl": {
                    "format": "uri",
                    "type": "string"
                  },
                  "price": {
                    "example": "0.50",
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "walletAddress": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "price",
                  "externalUrl"
                ],
                "type": "object"
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "externalUrl": {
                    "description": "Required when not uploading a file",
                    "format": "uri",
                    "type": "string"
                  },
                  "file": {
                    "description": "File upload (omit for link resource)",
                    "format": "binary",
                    "type": "string"
                  },
                  "price": {
                    "description": "USDC price",
                    "example": "0.50",
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "walletAddress": {
                    "description": "Override publisher wallet",
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "price"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            },
            "description": "Resource created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Validation error"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            },
            "description": "Rate limit exceeded"
          }
        },
        "security": [
          {
            "ApiKeyAuth": [],
            "RequestSignature": []
          }
        ],
        "summary": "Publish a new resource (file or link)",
        "tags": [
          "Resources"
        ]
      }
    },
    "/resources/{id}": {
      "delete": {
        "operationId": "delistResource",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource delisted"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found or not owned"
          }
        },
        "security": [
          {
            "ApiKeyAuth": [],
            "RequestSignature": []
          }
        ],
        "summary": "Delist a resource (owner only)",
        "tags": [
          "Resources"
        ]
      },
      "get": {
        "description": "Returns the resource content or a redirect URL after x402 payment. Responds with HTTP 402 if payment is missing.",
        "operationId": "accessResource",
        "parameters": [
          {
            "in": "path",
