{
  "expo": {
    "scheme": "mindvault",
    "name": "MindVault",
    "slug": "mindvault-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "imageWidth": 220,
      "resizeMode": "contain",
      "backgroundColor": "#4f46e5",
      "dark": {
        "image": "./assets/adaptive-icon.png",
        "imageWidth": 220,
        "backgroundColor": "#1f2937"
      }
    },
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/splash-icon.png",
        "tinted": "./assets/adaptive-icon.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "app.mindvault.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4f46e5"
      },
      "package": "app.mindvault.mobile"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MindVault to access your camera to scan QR codes."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4021",
      "network": "testnet",
      "networkPassphrase": "Test SDF Network ; September 2015"
    }
  }
}
